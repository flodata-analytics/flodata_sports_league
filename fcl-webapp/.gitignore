# =====================================
# Temporary & Backup Files
# =====================================
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
*.old
*_old
*_backup
README_old.md
.gitignore_old

# =====================================
# Project-specific
# =====================================

# Trash folder
__trash__/

# Local server keys
server/keys/
server/*.json
!server/package.json

# User-uploaded assets (if stored locally)
/public/uploads/
/public/avatars/

# Database dumps
*.sql
*.sqlite
*.sqlite3
*.db

# Payment gateway credentials
**/stripe-*.json
**/paypal-*.json
**/razorpay-*.json

# OAuth tokens
**/oauth-tokens.json
**/.oauth/

# Session storage
sessions/
*.session
